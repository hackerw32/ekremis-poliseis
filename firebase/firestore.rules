rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Προσοχή: ανοιχτή πρόσβαση σε όλες τις συλλογές της εφαρμογής.
    // Κατάλληλο για προσωπική/εσωτερική χρήση.
    // Για μεγαλύτερη ασφάλεια πρόσθεσε Firebase Auth και όρισε:
    //   allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
